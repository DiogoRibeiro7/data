{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diogoribeiro7.github.io/data/schemas/handoff-verification-result-v1.schema.json",
  "title": "Local canonical handoff verification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_version", "ok", "dataset_id", "repository", "commit",
    "verified_objects", "total_bytes", "manifest_sha256",
    "trusted_checkout_verified", "files"
  ],
  "properties": {
    "verification_version": {"const": 1},
    "ok": {"const": true},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verified_objects": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trusted_checkout_verified": {"type": "boolean"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "storage_key", "sha256", "size_bytes"],
        "properties": {
          "source_path": {
            "type": "string",
            "pattern": "^datasets/[a-z0-9-]+/(raw|derived)/"
          },
          "storage_key": {
            "type": "string",
            "pattern": "^canonical/[a-z0-9-]+/[0-9a-f]{64}/(raw|derived)/"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
