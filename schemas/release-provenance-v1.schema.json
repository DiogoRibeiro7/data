{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diogoribeiro7.github.io/data/schemas/release-provenance-v1.schema.json",
  "title": "Registry release provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "snapshot",
    "artifacts",
    "workflow",
    "versions",
    "release_assertions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "DiogoRibeiro7/data"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "manifest_version"],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^snapshot-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[1-9][0-9]*)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifest_version": {"type": "integer", "minimum": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_workflow", "publisher_workflow"],
      "properties": {
        "repository_workflow": {"type": "string", "minLength": 1},
        "publisher_workflow": {"type": "string", "minLength": 1}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_client", "static_distribution_version"],
      "properties": {
        "registry_client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "public_api_version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "public_api_version": {"type": "integer", "minimum": 1}
          }
        },
        "static_distribution_version": {"type": "integer", "minimum": 1}
      }
    },
    "release_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "required-before-provenance-generation"}
        }
      }
    }
  }
}
