{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DiogoRibeiro7/data/schemas/archive-identifiers-v1.schema.json",
  "title": "Registry archive identifiers v1",
  "type": "object",
  "required": ["schema_version", "repository", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"const": "DiogoRibeiro7/data"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "commit", "provider", "identifier"],
        "additionalProperties": false,
        "properties": {
          "tag": {"type": "string", "pattern": "^snapshot-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[1-9][0-9]*)?$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "provider": {"type": "string", "minLength": 1},
          "identifier": {"type": "string", "minLength": 1},
          "relation": {
            "enum": [
              "isIdenticalTo",
              "isSupplementTo",
              "isVersionOf",
              "isNewVersionOf",
              "isPreviousVersionOf"
            ]
          }
        }
      }
    }
  }
}
