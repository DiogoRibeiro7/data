{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DiogoRibeiro7/data/schemas/legacy-metadata-v0.schema.json",
  "title": "Legacy quarantine metadata v0",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "id",
    "title",
    "source",
    "license",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 0
    },
    "status": {
      "const": "legacy-quarantine"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "original_path",
          "path",
          "size_bytes",
          "git_blob_sha"
        ],
        "additionalProperties": false,
        "properties": {
          "original_path": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^raw/.+",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "review_status",
        "last_reviewed",
        "blocker_category",
        "blocker_summary",
        "evidence",
        "next_action",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "review_status": {
          "enum": [
            "actionable",
            "terminal"
          ]
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "blocker_category": {
          "enum": [
            "exact-snapshot-identity",
            "redistribution-rights",
            "dataset-vs-repository-licence-scope",
            "derived-lineage",
            "authoritative-source-identity",
            "historical-export-route"
          ]
        },
        "blocker_summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "pattern": "^https?://"
          }
        },
        "reviewer_note": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "terminal"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "properties": {
              "terminal": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "actionable"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "properties": {
              "terminal": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
