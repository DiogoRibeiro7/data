{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DiogoRibeiro7/data/schemas/canonical-metadata-v1.schema.json",
  "title": "Canonical dataset metadata v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "domain",
    "source",
    "license",
    "files",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "publisher",
        "url",
        "retrieved_at",
        "snapshot"
      ],
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "name",
        "url",
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "unknown"
          ]
        }
      }
    },
    "citation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ]
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "format",
          "sha256"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(raw|derived)/.+",
            "minLength": 1
          },
          "role": {
            "enum": [
              "raw",
              "derived"
            ]
          },
          "format": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._+-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "large_file_reviewed": {
            "type": "boolean"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "column_count": {
            "type": "integer",
            "minimum": 0
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          },
          "compression": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "output"
        ],
        "additionalProperties": true,
        "properties": {
          "output": {
            "type": "string",
            "pattern": "^derived/.+",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
