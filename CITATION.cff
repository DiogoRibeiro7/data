    given-names: "Diogo"
repository-code: "https://github.com/DiogoRibeiro7/data"
url: "https://diogoribeiro7.github.io/data/"
license: "MIT"
keywords:
  - "data registry"
  - "research data"
  - "data provenance"
  - "reproducibility"
  - "metadata"
